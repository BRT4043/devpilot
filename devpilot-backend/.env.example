# Copy to .env and fill in. NEVER commit .env — it's in .gitignore.

# App
APP_ENV=dev
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000

# Fernet key for encrypting GitHub tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me

# GitHub OAuth app (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# Infra (matches docker-compose service names)
DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@postgres:5432/devpilot
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# LLM provider — decide with the team, then fill one in
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash   # or gpt-4o-mini with LLM_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-004
